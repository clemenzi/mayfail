{
  "name": "mayfail-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "docs:dev": "pnpm --filter @mayfail/docs dev",
    "docs:build": "pnpm --filter @mayfail/docs build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "turbo": "^2.8.13",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.17.0"
}
