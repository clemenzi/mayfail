{
  "name": "mayfail",
  "version": "1.1.1",
  "description": "A tiny, dependency-free Result tuple helper for synchronous and asynchronous functions",
  "keywords": [
    "async",
    "error-handling",
    "result",
    "try-catch",
    "typescript"
  ],
  "homepage": "https://clemenzi.github.io/mayfail/",
  "bugs": {
    "url": "https://github.com/clemenzi/mayfail/issues"
  },
  "license": "MIT",
  "author": "Valerio Clemenzi <nc@vcz.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clemenzi/mayfail.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
