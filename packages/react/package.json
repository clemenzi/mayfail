{
  "name": "@mayfail/react",
  "version": "0.1.0",
  "description": "React integration for mayfail",
  "keywords": [
    "error-handling",
    "react",
    "result",
    "try-catch",
    "typescript"
  ],
  "homepage": "https://clemenzi.github.io/mayfail/",
  "license": "MIT",
  "author": "Valerio Clemenzi <nc@vcz.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clemenzi/mayfail.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "mayfail": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^27.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
