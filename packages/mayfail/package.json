{
  "name": "mayfail",
  "version": "1.1.2",
  "description": "A tiny, dependency-free Result tuple helper for synchronous and asynchronous functions",
  "keywords": [
    "async",
    "error-handling",
    "result",
    "try-catch",
    "typescript"
  ],
  "homepage": "https://clemenzi.github.io/mayfail/",
  "bugs": {
    "url": "https://github.com/clemenzi/mayfail/issues"
  },
  "license": "MIT",
  "author": "Valerio Clemenzi <nc@vcz.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clemenzi/mayfail.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  }
}
